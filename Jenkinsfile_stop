pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vinaykumarshetkar/cost-optimization.git'
            }
        }

        stage('Stop VM and Generate Cost Report') {
            steps {
                withCredentials([
                    azureServicePrincipal(
                        credentialsId: 'jenkins-azure-sp',
                        subscriptionIdVariable: 'AZ_SUBSCRIPTION_ID',
                        clientIdVariable: 'AZ_CLIENT_ID',
                        clientSecretVariable: 'AZ_CLIENT_SECRET',
                        tenantIdVariable: 'AZ_TENANT_ID'
                    )
                ]) {
                    script {

                        env.COST_REPORT = sh(
                            returnStdout: true,
                            script: '''
                            set -e

                            az login \
                              --service-principal \
                              --username "$AZ_CLIENT_ID" \
                              --password "$AZ_CLIENT_SECRET" \
                              --tenant "$AZ_TENANT_ID" >/dev/null

                            az account set --subscription "$AZ_SUBSCRIPTION_ID"

                            echo "Stopping VM..."
                            az vm deallocate \
                                --resource-group vinay \
                                --name testVM1

                            echo ""
                            echo "Generating Cost Report..."
                            chmod +x cost.sh
                            ./cost.sh
                            '''
                        ).trim()
                    }
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: 'vinay.abc.reports@gmail.com',
                subject: 'Azure VM Stopped Successfully',
                body: """
Hello,

The Azure VM operation completed successfully.

VM Name        : testVM1
Resource Group : vinay
Operation      : Stop
Status         : SUCCESS

==================================
Azure Cost Report
==================================

${env.COST_REPORT}

Build URL: ${env.BUILD_URL}

Regards,
Jenkins
"""
            )
        }

        failure {
            emailext(
                to: 'vinay.abc.reports@gmail.com',
                subject: 'Azure VM Operation Failed',
                body: """
Hello,

The Azure VM operation failed.

Build URL: ${env.BUILD_URL}

Regards,
Jenkins
"""
            )
        }

        always {
            cleanWs()
        }
    }
}
