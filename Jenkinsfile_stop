pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vinaykumarshetkar/cost-optimization.git'
            }
        }

        stage('Azure Login and Start VM') {
            steps {
                withCredentials([
                    azureServicePrincipal(
                        credentialsId: 'jenkins-azure-sp',
                        subscriptionIdVariable: 'AZ_SUBSCRIPTION_ID',
                        clientIdVariable: 'AZ_CLIENT_ID',
                        clientSecretVariable: 'AZ_CLIENT_SECRET',
                        tenantIdVariable: 'AZ_TENANT_ID'
                    )
                ]) {

                    sh '''
                    set -e

                    az --version
                    az login \
                      --service-principal \
                      --username "$AZ_CLIENT_ID" \
                      --password "$AZ_CLIENT_SECRET" \
                      --tenant "$AZ_TENANT_ID"

                    az account set --subscription "$AZ_SUBSCRIPTION_ID"

                    az account show
                    az vm get-instance-view \
                      --resource-group vinay \
                      --name testVM1 \
                      --query "instanceView.statuses[?code=='PowerState/running']"

                    az vm Deallocate \
                      --resource-group vinay \
                      --name testVM1
                    '''
                }
            }
        }
    }
post {
    success {
        emailext(
            subject: "Azure VM Started Successfully",
            body: """
Hello,

The Azure VM operation completed successfully.

VM Name          : testVM1
Resource Group   : vinay
Operation        : Stop
Status           : SUCCESS

Regards,
Jenkins
""",
            to: "vinay.abc.reports@gmail.com"
        )
    }

    failure {
        emailext(
            subject: "Azure VM Operation Failed",
            body: """
The Azure VM operation failed.

Please check the Jenkins console logs.

Build URL: ${env.BUILD_URL}
""",
            to: "vinay.abc.reports@gmail.com"
        )
    }
    }
}
